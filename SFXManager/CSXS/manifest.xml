<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest ExtensionBundleId="com.nadim.sfxmanager"
                   ExtensionBundleName="SFX Manager"
                   ExtensionBundleVersion="1.0.9"
                   Version="4.0"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.nadim.sfxmanager.panel" Version="1.0.9"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects (AEFT) 18.0 = 2021 through current versions -->
      <Host Name="AEFT" Version="[18.0,99.9]"/>
      <!-- Premiere Pro (PPRO) 14.0 = 2020 through current versions -->
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <!-- CEP 10 (AE 2021+) — panel uses flex gap / backdrop-filter -->
      <RequiredRuntime Name="CSXS" Version="10.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.nadim.sfxmanager.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node.js gives the panel fast, native filesystem access -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>SFX Manager</Menu>
          <Geometry>
            <Size>
              <!-- default floating window ≈ 9:16 vertical -->
              <Height>604</Height>
              <Width>340</Width>
            </Size>
            <MinSize>
              <Height>460</Height>
              <Width>300</Width>
            </MinSize>
            <MaxSize>
              <Height>2400</Height>
              <Width>1600</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
